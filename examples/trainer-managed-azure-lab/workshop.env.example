# Trainer managed Azure lab configuration
# Author: Victoria Eshelby
# Copy this file to .env and replace every value in angle brackets.

TENANT_ID=<your-tenant-guid>
SUBSCRIPTION_ID=<your-subscription-guid>
RESOURCE_GROUP=<workshop-resource-group>
LAB_NAME=<existing-devtest-lab>
LOCATION=<azure-region>
DOMAIN=<your-tenant-domain>

VM_SIZE=Standard_B2ms
STORAGE_TYPE=StandardSSD
LOCAL_ADMIN_USER=student
LEARNER_COUNT=29
VM_NAME_PREFIX=workshop-student
LEARNER_PREFIX=learner

GROUP_NAME=Workshop-Learners
GROUP_NICKNAME=workshop-learners
DEMO_USER_UPN=<existing-demo-user-upn>
DEMO_VM_NAME=workshop-demo

SHUTDOWN_TIME=1230
SHUTDOWN_TIMEZONE=UTC
STARTUP_TIME=0900
SESSION_START=<iso-8601-start-time-with-offset>
SESSION_END=<iso-8601-end-time-with-offset>

TAP_LIFETIME_MINUTES=300
TAP_USABLE_ONCE=false

FOUNDRY_NAME=<globally-unique-foundry-name>
FOUNDRY_PROJECT=workshop-project
MODEL_NAME=gpt-5-mini
MODEL_VERSION=
MODEL_SKU=GlobalStandard
MODEL_CAPACITY=10
SEARCH_NAME=<globally-unique-search-name>
SEARCH_SKU=basic
ENTRA_ONLY_AUTH=true

DTL_API_VERSION=2018-09-15

TAG_COURSE=AI-901
TAG_COHORT=CommunityWorkshop
TAG_ENVIRONMENT=Training
TAG_OWNER=WorkshopTrainer
TAG_COST_CONTROL=Required